{
    "name": "Plugin: RSS Feed Scroller",
    "options": [{
        "title": "Scroller",
        "type": "section"
    }, {
        "title": "Font",
        "ui_width": 4,
        "name": "font",
        "type": "font",
        "doc_link": true,
        "default": "default-font.ttf"
    }, {
        "title": "Size",
        "ui_width": 2,
        "type": "integer",
        "name": "size",
        "default": 40
    }, {
        "title": "Font Color",
        "ui_width": 2,
        "type": "color",
        "name": "color",
        "default": [1,1,1,1]
    }, {
        "title": "Scroll Speed",
        "ui_width": 4,
        "name": "speed",
        "type": "select",
        "options": [
            [ 30, "Slow"],
            [ 60, "Normal"],
            [120, "Fast"],
            [180, "Faster"],
            [240, "Even faster"]
        ],
        "default": 120
    },

    {
        "title": "RSS Feed",
        "type": "section"
    }, {
        "title": "RSS Feed URL",
        "ui_width": 12,
        "name": "rss_url",
        "type": "string",
        "default": "https://www.tagesschau.de/infoservices/alle-meldungen-100~rss2.xml",
        "hint": "URL of the RSS feed to display"
    }, {
        "title": "Update Interval",
        "ui_width": 4,
        "name": "update_interval",
        "type": "integer",
        "default": 300,
        "hint": "Seconds between RSS feed updates"
    }, {
        "title": "Separator",
        "ui_width": 4,
        "name": "separator",
        "type": "string",
        "default": " +++ ",
        "hint": "Text between news items"
    }, {
        "title": "Default Text",
        "ui_width": 4,
        "name": "default_text",
        "type": "string",
        "default": "RSS feed not available",
        "hint": "Text to display when RSS feed cannot be loaded"
    }]
}
